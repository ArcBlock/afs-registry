{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AFS Provider Registry",
  "description": "Schema for the AFS provider registry manifest file",
  "type": "object",
  "required": ["providers"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference"
    },
    "providers": {
      "type": "array",
      "description": "List of provider manifests",
      "items": {
        "$ref": "#/definitions/ProviderManifest"
      }
    }
  },
  "definitions": {
    "ConfigSchemaProperty": {
      "type": "object",
      "description": "JSON Schema property with optional AFS credential metadata",
      "properties": {
        "type": { "type": "string" },
        "description": { "type": "string" },
        "enum": {
          "type": "array",
          "items": { "type": "string" }
        },
        "sensitive": {
          "type": "boolean",
          "description": "When true, this field contains sensitive data (tokens, keys, passwords). Sensitive fields are stored in credentials.toml (chmod 600) and collected via secure channels (MCP URL mode / CLI masked input)."
        },
        "env": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Environment variable names to check for this field's value, in priority order (e.g. [\"GITHUB_TOKEN\", \"GH_TOKEN\"]). Used for silent credential resolution before prompting the user."
        }
      },
      "required": ["type"]
    },
    "ProviderManifest": {
      "type": "object",
      "required": ["name", "description", "category", "uriTemplate"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Unique provider name"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable description"
        },
        "category": {
          "type": "string",
          "enum": [
            "storage",
            "version-control",
            "database",
            "structured-data",
            "compute",
            "composite",
            "cloud-storage",
            "cloud-compute",
            "cloud-dns",
            "cloud-platform",
            "integration",
            "network",
            "api"
          ],
          "description": "Provider category"
        },
        "uriTemplate": {
          "type": "string",
          "minLength": 1,
          "description": "URI template with {param} placeholders for mounting"
        },
        "schema": {
          "type": "object",
          "description": "JSON Schema describing provider parameters. Properties may include 'sensitive' (boolean) and 'env' (string[]) for credential management.",
          "properties": {
            "type": { "type": "string", "const": "object" },
            "properties": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/ConfigSchemaProperty"
              }
            },
            "required": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Searchable tags"
        },
        "useCases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Common use cases"
        }
      },
      "additionalProperties": false
    }
  }
}
